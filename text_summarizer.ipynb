   "source": [
    "## Data preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "ee5ed723-f72e-4a37-afbb-190fc450d333",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "def clean_data(text):\n",
    "    text= re.sub(r'\\r\\n', ' ', text) ##replace lines with space\n",
    "    text= re.sub(r'\\s+', ' ', text) ##replace extra space with space\n",
    "    text= re.sub(r'<.*?>', ' ', text) ##replace html tags with space\n",
    "    text= text.strip().lower() ##removes trailing spaces and convert into lowercase\n",
    "    return text\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "400cdfa8-999f-4b38-bba3-043adcd3f0d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_data['dialogue']= train_data['dialogue'].apply(clean_data)\n",
    "train_data['summary']= train_data['summary'].apply(clean_data)\n",
    "\n",
    "val_data['dialogue']= val_data['dialogue'].apply(clean_data)\n",
    "val_data['summary']= val_data['summary'].apply(clean_data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "048c1338-bda1-43da-80a3-b1a1c1c28b1b",
